loginPageHandler()

// Main function for passing and obtaining values from PHP

function getLoginData(){
    const loginFormSubmit = document.querySelector("#sign_in")
    loginFormSubmit.addEventListener("submit", (evt) => {
        evt.preventDefault();
        const loginFormData = new FormData(document.querySelector("#sign_in"))  
        const objloginFormData = Object.fromEntries(loginFormData);
            var url = "../query/login.qry.php";
            reqUserLoginData(url,objloginFormData);
    });
}


async function reqUserLoginData(url,data) {
    fetch(url, {
        method: "POST", 
        headers: {"Content-Type": "application/json",},
        body: JSON.stringify(data),
    })
    .then(res => res.json(console.log(res)))
    .then(data => { 
        console.log(data);
    })
    .catch(error => {
        console.log(error);
    });
}

